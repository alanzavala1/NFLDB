# Python
**/__pycache__/
**/*.pyc

# Virtualenvs (the real one + the stray empty one at api/ root)
api/venv/
api/.venv/
api/Scripts/
api/Lib/
api/Include/
api/pyvenv.cfg

# Local environment files can contain credentials. Supply secrets at runtime.
**/.env
**/.env.*
**/gha-creds-*.json

# Databases arrive through explicit named contexts for each target. Local
# captures, experiments and databases never enter the shared source context.
api/data/
api/experiments/
api/docs/

# Frontend deps + build (the image rebuilds dist in stage 1)
frontend/node_modules/
frontend/dist/

# Repo cruft
.git/
.github/
notes/
docs/
.claude/
**/.pytest_cache/
**/.ruff_cache/
**/node_modules/
*.log
_qa_*.mjs
